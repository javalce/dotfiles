#!/bin/zsh
#
# .zstyles - zstyle settings for features/plugins that need them
#

# Auto convert .... to ../..
# Disabled because it is disgusting and it is not a good idea to use ..
# to navigate to the parent directory. It is better to use the 'cd' command explicitly.
zstyle ':zim:input' double-dot-expand no

# Terminal title
zstyle ':zim:termtitle' format '%1~'

# FNM configuration
zstyle ':plugins:fnm' use-on-cd yes

